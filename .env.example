# =============================================================================
# Flowstate Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -- Frontend (VITE_ prefix = exposed to browser, keep these public-safe) -----

# InsForge project URL (from InsForge dashboard -> Project Settings)
VITE_INSFORGE_URL=https://your-project.insforge.app

# InsForge anonymous/public key (safe for browser)
VITE_INSFORGE_ANON_KEY=your-anon-key

# Slack App Client ID (from https://api.slack.com/apps -> Basic Information)
VITE_SLACK_CLIENT_ID=your-slack-client-id

# -- Server-side (set these as InsForge Edge Function Secrets via dashboard) ---

# InsForge service role key (bypasses RLS — never expose to browser)
INSFORGE_SERVICE_ROLE_KEY=your-service-role-key

# Slack App Credentials (from https://api.slack.com/apps -> Basic Information)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# InsForge Model Gateway (Phase 2 — not needed for Phase 1)
MODEL_GATEWAY_URL=your-model-gateway-url
MODEL_GATEWAY_KEY=your-model-gateway-key
